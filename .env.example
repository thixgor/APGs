# Copie para ".env" (local) e configure também nas Environment Variables do Vercel.

# String de conexão do MongoDB Atlas.
# Ex.: mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Nome do banco (opcional; padrão: domineaqui)
MONGODB_DB=domineaqui

# Senha única compartilhada que você e seu amigo usam para entrar no site.
APP_PASSWORD=
